# ── 後端 API ──
# Cross 後端本地跑 8001（8000 被其他服務佔用）
NEXT_PUBLIC_API_URL=http://localhost:8001
BACKEND_URL=http://localhost:8001

# ── 第三方登入 ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# ── 夥伴加入通知信（Resend）──
RESEND_API_KEY=
JOIN_NOTIFY_EMAIL=
JOIN_NOTIFY_FROM=

# ── 造訪人數的 IP 雜湊 salt（正式環境務必設定）──
# 原始 IP 只在 src/app/api/track-view/route.ts 出現，雜湊後才送後端。
# 未設定時會退回程式內建的固定字串：功能仍可運作、去重仍正確，
# 但 salt 一旦公開，IPv4 只有 43 億種可能，雜湊可被暴力反查回 IP。
# 正式站請設一個夠長的隨機值，且不要隨部署變動（變了會讓舊訪客重新計數）。
VISITOR_HASH_SALT=

# ── 其他 ──
NEXT_PUBLIC_USE_MOCK_DATA=false
# Google Search Console 網站擁有權驗證
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
